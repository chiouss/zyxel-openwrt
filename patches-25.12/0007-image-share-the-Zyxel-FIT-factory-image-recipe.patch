From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Chiou <chiouss@gmail.com>
Date: Sun, 1 Nov 2026 09:18:55 +0800
Subject: [PATCH] image: share the Zyxel FIT factory image recipe

The Zyxel stock firmware on the MT7981B and IPQ40xx based access points
accepts the same factory image: a UBI image wrapped in an outer FIT whose
"compat-models" property lists up to five two-byte model IDs. filogic and
ipq40xx each carried a copy of the recipe, differing only in how many
model IDs a device can set.

Move it to include/image-commands.mk as zyxel-fit-factory-img, taking
ZYXEL_MODEL_ID_0 to ZYXEL_MODEL_ID_4 like the filogic version, and switch
both targets to it. The ipq40xx devices now set ZYXEL_MODEL_ID_0. The
generated images are unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Mark Chiou <chiouss@gmail.com>
---
 include/image-commands.mk              | 10 ++++++++++
 target/linux/ipq40xx/image/generic.mk  | 20 ++++++--------------
 target/linux/mediatek/image/filogic.mk |  9 +--------
 3 files changed, 17 insertions(+), 22 deletions(-)

diff --git a/include/image-commands.mk b/include/image-commands.mk
index e278cf1b196..46528464ec3 100644
--- a/include/image-commands.mk
+++ b/include/image-commands.mk
@@ -863,6 +863,16 @@ define Build/zyimage
 	$(STAGING_DIR_HOST)/bin/zyimage $(1) $@
 endef
 
+# Wrap the image in the outer FIT the Zyxel stock firmware checks before
+# accepting it as a factory image. It carries up to five two-byte model IDs
+# (ZYXEL_MODEL_ID_0 to ZYXEL_MODEL_ID_4), unused slots are filled with ff ff.
+define Build/zyxel-fit-factory-img
+	$(TOPDIR)/scripts/mkits-zyxel-fit-filogic.sh \
+		$@.its $@ "$(foreach i,0 1 2 3 4,$(or $(ZYXEL_MODEL_ID_$(i)),ff ff))"
+	PATH=$(LINUX_DIR)/scripts/dtc:$(PATH) mkimage -f $@.its $@.new
+	@mv $@.new $@
+endef
+
 define Build/zyxel-ras-image
 	let \
 		newsize="$(call exp_units,$(RAS_ROOTFS_SIZE))"; \
diff --git a/target/linux/ipq40xx/image/generic.mk b/target/linux/ipq40xx/image/generic.mk
index a87d94812e1..d25e4f97832 100644
--- a/target/linux/ipq40xx/image/generic.mk
+++ b/target/linux/ipq40xx/image/generic.mk
@@ -4,22 +4,14 @@ DEVICE_VARS += RAS_BOARD RAS_ROOTFS_SIZE RAS_VERSION
 DEVICE_VARS += WRGG_DEVNAME WRGG_SIGNATURE
 DEVICE_VARS += SUPPORTED_TELTONIKA_DEVICES
 DEVICE_VARS += SUPPORTED_TELTONIKA_HW_MODS
-DEVICE_VARS += ZYXEL_MODEL_ID
+DEVICE_VARS += ZYXEL_MODEL_ID_0 ZYXEL_MODEL_ID_1 ZYXEL_MODEL_ID_2
+DEVICE_VARS += ZYXEL_MODEL_ID_3 ZYXEL_MODEL_ID_4
 
 define Build/netgear-fit-padding
 	./netgear-fit-padding.py $@ $@.new
 	mv $@.new $@
 endef
 
-# Wrap the image in the outer FIT the stock firmware checks against the
-# device model ID before accepting it as a factory image.
-define Build/zyxel-ipq40xx-fit
-	$(TOPDIR)/scripts/mkits-zyxel-fit-filogic.sh \
-		$@.its $@ "$(ZYXEL_MODEL_ID) ff ff ff ff ff ff ff ff"
-	PATH=$(LINUX_DIR)/scripts/dtc:$(PATH) mkimage -f $@.its $@.new
-	@mv $@.new $@
-endef
-
 define Device/FitImage
 	KERNEL_SUFFIX := -uImage.itb
 	KERNEL = kernel-bin | gzip | fit gzip $$(KDIR)/image-$$(DEVICE_DTS).dtb
@@ -1434,28 +1426,28 @@ define Device/zyxel_wac500_common
 	PAGESIZE := 2048
 	IMAGE_SIZE := 53248k
 	IMAGES += factory.bin
-	IMAGE/factory.bin := append-ubi | check-size $$$$(IMAGE_SIZE) | zyxel-ipq40xx-fit
+	IMAGE/factory.bin := append-ubi | check-size $$$$(IMAGE_SIZE) | zyxel-fit-factory-img
 	DEVICE_PACKAGES := uboot-envtools zyxel-bootconfig-ipq
 endef
 
 define Device/zyxel_nwa1123acv3
 	$(call Device/zyxel_wac500_common)
 	DEVICE_MODEL := NWA1123ACv3
-	ZYXEL_MODEL_ID := 62 e1
+	ZYXEL_MODEL_ID_0 := 62 e1
 endef
 TARGET_DEVICES += zyxel_nwa1123acv3
 
 define Device/zyxel_wac500
 	$(call Device/zyxel_wac500_common)
 	DEVICE_MODEL := WAC500
-	ZYXEL_MODEL_ID := 63 e1
+	ZYXEL_MODEL_ID_0 := 63 e1
 endef
 TARGET_DEVICES += zyxel_wac500
 
 define Device/zyxel_wac500h
 	$(call Device/zyxel_wac500_common)
 	DEVICE_MODEL := WAC500H
-	ZYXEL_MODEL_ID := 64 e1
+	ZYXEL_MODEL_ID_0 := 64 e1
 endef
 TARGET_DEVICES += zyxel_wac500h
 
diff --git a/target/linux/mediatek/image/filogic.mk b/target/linux/mediatek/image/filogic.mk
index 8bd206d3e61..4ceba9be8aa 100644
--- a/target/linux/mediatek/image/filogic.mk
+++ b/target/linux/mediatek/image/filogic.mk
@@ -119,13 +119,6 @@ define Build/mstc-header
   mv $@.new $@
 endef
 
-define Build/zyxel-fit-filogic
-	$(TOPDIR)/scripts/mkits-zyxel-fit-filogic.sh \
-		$@.its $@ "$(foreach i,0 1 2 3 4,$(or $(ZYXEL_MODEL_ID_$(i)),ff ff))"
-	PATH=$(LINUX_DIR)/scripts/dtc:$(PATH) mkimage -f $@.its $@.new
-	@mv $@.new $@
-endef
-
 define Build/cetron-header
 	$(eval magic=$(word 1,$(1)))
 	$(eval model=$(word 2,$(1)))
@@ -3876,7 +3869,7 @@ define Device/zyxel_filogic_common
   IMAGE_SIZE := 51200k
   KERNEL_IN_UBI := 1
   IMAGES += factory.bin
-  IMAGE/factory.bin := append-ubi | check-size $$$$(IMAGE_SIZE) | zyxel-fit-filogic
+  IMAGE/factory.bin := append-ubi | check-size $$$$(IMAGE_SIZE) | zyxel-fit-factory-img
   IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
   ZYXEL_MODEL_ID_0 :=
   ZYXEL_MODEL_ID_1 :=
