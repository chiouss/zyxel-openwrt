+
+define Device/zyxel_wax650s
+	$(call Device/zyxel_nwax10ax_common)
+	DEVICE_MODEL := WAX650S
+	DEVICE_DTS_CONFIG := config@hk09
+	SOC := ipq8072
+	DEVICE_PACKAGES := zyxel-bootconfig-ipq kmod-leds-lp5562
+	UBINIZE_PARTS := ethphyfw=$(CURDIR)/zyxel-ethphyfw.stub=1
+	$(call Device/zyxel-fit-factory-img,54 e1)
+endef
+TARGET_DEVICES += zyxel_wax650s
