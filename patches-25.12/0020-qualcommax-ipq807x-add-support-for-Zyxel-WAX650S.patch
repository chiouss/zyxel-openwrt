--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq8072-wax650s.dts
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/dts-v1/;
+
+#include "ipq807x-nwax10ax.dtsi"
+
+/ {
+	model = "Zyxel WAX650S";
+	compatible = "zyxel,wax650s", "qcom,ipq8074";
+
+	aliases {
+		ethernet0 = &dp5_syn;
+		ethernet1 = &dp1;
+		label-mac-device = &dp5_syn;
+	};
+
+	chosen {
+		/* the ethphyfw UBI volume comes first, see the image recipe */
+		bootargs-append = " root=/dev/ubiblock0_2 loglevel=7";
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		gpio_green {
+			gpios = <&tlmm 50 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+		};
+
+		gpio_red {
+			gpios = <&tlmm 51 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_STATUS;
+		};
+	};
+};
+
+&switch {
+	switch_lan_bmp = <(ESS_PORT1 | ESS_PORT5)>;
+	switch_mac_mode = <MAC_MODE_SGMII_CHANNEL0>;
+	switch_mac_mode1 = <MAC_MODE_USXGMII>;
+};
+
+&phyinfo {
+	port@5 {
+		port_id = <5>;
+		phy_address = <8>;
+		ethernet-phy-ieee802.3-c45;
+	};
+};
+
+&mdio {
+	/*
+	 * The stock bootloader loads the PHY firmware from the "ethphyfw"
+	 * UBI volume on every boot. Leave out the reset GPIO (63), as a
+	 * reset would clear it.
+	 */
+	aqr114c: ethernet-phy@8 {
+		compatible = "ethernet-phy-ieee802.3-c45";
+		reg = <8>;
+	};
+};
+
+&dp1 {
+	label = "lan1";
+	nvmem-cell-names = "mac-address";
+	nvmem-cells = <&label_mac 1>;
+};
+
+&dp5_syn {
+	status = "okay";
+	phy-handle = <&aqr114c>;
+	phy-mode = "usxgmii";
+	label = "uplink";
+	nvmem-cell-names = "mac-address";
+	nvmem-cells = <&label_mac 0>;
+};
+
+&wifi {
+	qcom,ath11k-calibration-variant = "Zyxel-WAX650S";
+};
