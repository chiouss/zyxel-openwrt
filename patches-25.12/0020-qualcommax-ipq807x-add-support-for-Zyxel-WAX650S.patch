diff --git a/target/linux/qualcommax/ipq807x/base-files/lib/preinit/96_zyxel_ethphyfw b/target/linux/qualcommax/ipq807x/base-files/lib/preinit/96_zyxel_ethphyfw
new file mode 100644
index 0000000000..d35bdbd05a
--- /dev/null
+++ b/target/linux/qualcommax/ipq807x/base-files/lib/preinit/96_zyxel_ethphyfw
@@ -0,0 +1,86 @@
+#!/bin/sh
+#
+# The Zyxel WAX650S uplink PHY (AQR114C) runs firmware that the stock
+# bootloader loads on every boot from the "ethphyfw" UBI volume of the
+# "rootfs" partition. The OpenWrt image carries an empty "ethphyfw" volume:
+# fill it from the stock firmware in "rootfs_1" and reboot once, so the
+# bootloader can start the PHY.
+
+. /lib/functions.sh
+
+zyxel_ethphyfw_vol() {
+	local ubi="$1" name="$2" vol dev
+
+	for vol in /sys/class/ubi/${ubi}_*; do
+		[ "$(cat "$vol/name" 2>/dev/null)" = "$name" ] || continue
+
+		# Nothing adds device nodes in preinit for a UBI device
+		# attached after procd populated /dev.
+		dev="/dev/${vol##*/}"
+		[ -c "$dev" ] || mknod "$dev" c $(tr ':' ' ' < "$vol/dev") || \
+			return 1
+		echo "$dev"
+		return 0
+	done
+	return 1
+}
+
+# Print the payload size of a valid PHY firmware MBN header (image type 0x13,
+# version 3), nothing otherwise.
+zyxel_ethphyfw_size() {
+	local type vsn src dest size
+
+	read -r type vsn src dest size <<-EOF
+		$(dd if="$1" bs=40 count=1 2>/dev/null | hexdump -v -e '5/4 "%u " "\n"')
+	EOF
+	[ "$type" = 19 ] && [ "$vsn" = 3 ] && [ "$size" -gt 0 ] 2>/dev/null && \
+		[ "$size" -lt 1048000 ] && echo "$size"
+}
+
+zyxel_ethphyfw_log() {
+	echo "zyxel-ethphyfw: $*" > /dev/kmsg
+}
+
+zyxel_ethphyfw_copy() {
+	local dst="$1" mtd src size ret=1
+
+	mtd=$(find_mtd_index rootfs_1)
+	[ -n "$mtd" ] || return 1
+	ubiattach -m "$mtd" -d 7 >/dev/null 2>&1 || return 1
+
+	src=$(zyxel_ethphyfw_vol ubi7 ethphyfw)
+	[ -n "$src" ] && size=$(zyxel_ethphyfw_size "$src")
+	if [ -n "$size" ]; then
+		head -c $((size + 40)) "$src" > /tmp/ethphyfw.mbn && \
+			ubiupdatevol "$dst" /tmp/ethphyfw.mbn && ret=0
+		rm -f /tmp/ethphyfw.mbn
+	fi
+
+	ubidetach -d 7 >/dev/null 2>&1
+	[ -n "$src" ] && rm -f "$src"
+	return $ret
+}
+
+zyxel_ethphyfw() {
+	local dst
+
+	case "$(board_name)" in
+	zyxel,wax650s)
+		;;
+	*)
+		return 0
+		;;
+	esac
+
+	dst=$(zyxel_ethphyfw_vol ubi0 ethphyfw) || return 0
+	[ -n "$(zyxel_ethphyfw_size "$dst")" ] && return 0
+
+	if zyxel_ethphyfw_copy "$dst"; then
+		zyxel_ethphyfw_log "copied from the stock firmware, rebooting"
+		sync
+		reboot -f
+	fi
+	zyxel_ethphyfw_log "no firmware in the stock image, the uplink port stays down"
+}
+
+[ "$INITRAMFS" = "1" ] || boot_hook_add preinit_main zyxel_ethphyfw
