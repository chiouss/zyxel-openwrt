diff --git a/package/utils/zyxel-bootconfig-ipq/files/95_apply_bootconfig b/package/utils/zyxel-bootconfig-ipq/files/95_apply_bootconfig
index 648fec95c0..d7174b5b2e 100644
--- a/package/utils/zyxel-bootconfig-ipq/files/95_apply_bootconfig
+++ b/package/utils/zyxel-bootconfig-ipq/files/95_apply_bootconfig
@@ -5,7 +5,8 @@ apply_bootconfig() {
 	zyxel,nwa210ax|\
 	zyxel,nwa1123acv3|\
 	zyxel,wac500h|\
-	zyxel,nwa220ax-6e)
+	zyxel,nwa220ax-6e|\
+	zyxel,wax640s-6e)
 		status="$(zyxel-bootconfig-ipq show | awk '/image0:/ {print $2}')"
 		[ "$status" != "selected" ] && zyxel-bootconfig-ipq --force set image0
 		;;
diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-wax640s-6e.dts b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-wax640s-6e.dts
new file mode 100644
index 0000000000..5434a78bdc
--- /dev/null
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-wax640s-6e.dts
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/dts-v1/;
+
+#include "ipq5018-zyxel-6e.dtsi"
+#include "ipq5018-qcn6122.dtsi"
+
+/ {
+	model = "Zyxel WAX640S-6E";
+	compatible = "zyxel,wax640s-6e", "qcom,ipq5018";
+};
+
+&blsp1_i2c3 {
+	status = "okay";
+
+	pinctrl-0 = <&i2c_pins>;
+	pinctrl-names = "default";
+
+	lp5562@30 {
+		compatible = "ti,lp5562";
+		reg = <0x30>;
+		clock-mode = [02];
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		led_status_red: led@0 {
+			reg = <0>;
+			chan-name = "lp5562_red";
+			led-cur = [20];
+			max-cur = [60];
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_STATUS;
+		};
+
+		led_status_green: led@1 {
+			reg = <1>;
+			chan-name = "lp5562_green";
+			led-cur = [20];
+			max-cur = [60];
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_STATUS;
+		};
+
+		led_status_blue: led@2 {
+			reg = <2>;
+			chan-name = "lp5562_blue";
+			led-cur = [20];
+			max-cur = [60];
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_STATUS;
+		};
+
+		led_status_white: led@3 {
+			reg = <3>;
+			chan-name = "lp5562_white";
+			led-cur = [20];
+			max-cur = [60];
+			color = <LED_COLOR_ID_WHITE>;
+			function = LED_FUNCTION_STATUS;
+		};
+	};
+};
+
+&tlmm {
+	i2c_pins: i2c-state {
+		pins = "gpio25", "gpio26";
+		function = "blsp2_i2c1";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	/* antenna direction select, all low as set up by the vendor firmware */
+	ant-dir-hog {
+		gpio-hog;
+		gpios = <14 GPIO_ACTIVE_HIGH>,
+			<16 GPIO_ACTIVE_HIGH>,
+			<17 GPIO_ACTIVE_HIGH>,
+			<19 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "ant-dir";
+	};
+
+	rst-radio-hog {
+		gpio-hog;
+		gpios = <24 GPIO_ACTIVE_HIGH>,
+			<40 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "rst-radio";
+	};
+};
+
+&pcie_wifi {
+	qcom,ath11k-calibration-variant = "Zyxel-WAX640S-6E";
+
+	ieee80211-freq-limit = <5945000 7125000>;
+};
+
+&q6v5_wcss {
+	/* QCN6102: PCIe1, user PD 2, reset GPIO18 */
+	boot-args = <0x2 4 2 18 0 0>;
+};
+
+&wifi {
+	status = "okay";
+
+	qcom,rproc = <&q6_wcss_pd1>;
+	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";
+	qcom,ath11k-calibration-variant = "Zyxel-WAX640S-6E";
+	qcom,ath11k-fw-memory-mode = <1>;
+	qcom,bdf-addr = <0x4c400000>;
+};
+
+&wifi1 {
+	status = "okay";
+
+	/*
+	 * PCIe MSIs (QCN9024) are allocated from the first GICv2m frame,
+	 * so signal the QCN6102 interrupts through the second one.
+	 */
+	reg = <0x0b00b040 0x0>;
+	interrupts = <GIC_SPI 448 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 449 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 450 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 451 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 452 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 453 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 454 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 455 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 456 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 457 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 458 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 459 IRQ_TYPE_EDGE_RISING>,
+		     <GIC_SPI 460 IRQ_TYPE_EDGE_RISING>;
+
+	qcom,rproc = <&q6_wcss_pd2>;
+	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
+	qcom,ath11k-calibration-variant = "Zyxel-WAX640S-6E";
+	qcom,ath11k-fw-memory-mode = <1>;
+	qcom,bdf-addr = <0x4d100000>;
+	qcom,m3-dump-addr = <0x4df00000>;
+};
diff --git a/target/linux/qualcommax/image/ipq50xx.mk b/target/linux/qualcommax/image/ipq50xx.mk
index a9608a06f0..b37dddad03 100644
--- a/target/linux/qualcommax/image/ipq50xx.mk
+++ b/target/linux/qualcommax/image/ipq50xx.mk
@@ -275,3 +275,25 @@ define Device/zyxel_scr50axe
 		ipq-wifi-zyxel_scr50axe
 endef
 TARGET_DEVICES += zyxel_scr50axe
+
+define Device/zyxel_wax640s-6e
+	$(call Device/FitImage)
+	$(call Device/UbiFit)
+	DEVICE_VENDOR := Zyxel
+	DEVICE_MODEL := WAX640S-6E
+	SOC := ipq5018
+	BLOCKSIZE := 128k
+	PAGESIZE := 2048
+	NAND_SIZE := 256m
+	IMAGE_SIZE := 63488k
+	DEVICE_DTS_CONFIG := config@mp03.3
+	IMAGES += factory.bin
+	IMAGE/factory.bin := append-ubi | check-size $$$$(IMAGE_SIZE) | zyxel-fit-factory-img
+	ZYXEL_MODEL_ID_0 := 74 e1
+	DEVICE_PACKAGES := ath11k-firmware-ipq5018-qcn6122 \
+		kmod-ath11k-pci \
+		ath11k-firmware-qcn9074 \
+		kmod-leds-lp5562 \
+		zyxel-bootconfig-ipq
+endef
+TARGET_DEVICES += zyxel_wax640s-6e
diff --git a/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/01_leds b/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/01_leds
index 54dbfc81d0..6fb3164cfd 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/01_leds
+++ b/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/01_leds
@@ -26,7 +26,8 @@ linksys,mr5500)
 	ucidef_set_led_netdev "wan-port-link" "WAN-PORT-LINK" "qca8k-0.0:04:green:wan" "wan" "link_10 link_100 link_1000"
 	ucidef_set_led_netdev "wan-port-activity" "WAN-PORT-ACTIVITY" "qca8k-0.0:04:amber:wan" "wan" "tx rx"
 	;;
-zyxel,nwa220ax-6e)
+zyxel,nwa220ax-6e|\
+zyxel,wax640s-6e)
 	ucidef_set_led_netdev "uplink-2500" "UPLINK-2500" "90000.mdio-1:10:green:lan" "uplink" "link_2500 tx rx"
 	ucidef_set_led_netdev "uplink-1000" "UPLINK-1000" "90000.mdio-1:10:amber:lan" "uplink" "link_10 link_100 link_1000 tx rx"
 	ucidef_set_led_netdev "lan1-1000" "LAN1-1000" "88000.mdio-1:07:green:lan" "lan1" "link_1000 tx rx"
diff --git a/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/02_network b/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/02_network
index dd67af4dee..5cef2120f0 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/02_network
+++ b/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/02_network
@@ -29,7 +29,8 @@ ipq50xx_setup_interfaces()
 	yuncore,ax850)
 		ucidef_set_interfaces_lan_wan "lan" "wan"
 		;;
-	zyxel,nwa220ax-6e)
+	zyxel,nwa220ax-6e|\
+	zyxel,wax640s-6e)
 		ucidef_set_interface_lan "uplink lan1" "dhcp"
 		;;
 	esac
diff --git a/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata b/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata
index 953bfe9e47..3739bfc71c 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata
+++ b/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata
@@ -57,7 +57,8 @@ case "$FIRMWARE" in
 		ath11k_remove_regdomain
 		ath11k_set_macflag
 		;;
-	zyxel,nwa220ax-6e)
+	zyxel,nwa220ax-6e|\
+	zyxel,wax640s-6e)
 		caldata_extract "0:art" 0x1000 0x20000
 		label_mac=$(get_mac_label_dt)
 		ath11k_patch_mac $(macaddr_add $label_mac 2) 0
@@ -125,6 +126,13 @@ case "$FIRMWARE" in
 		ath11k_patch_mac $wlan_mac 0
 		ath11k_set_macflag
 		;;
+	zyxel,wax640s-6e)
+		caldata_extract "0:art" 0x26800 0x20000
+		label_mac=$(get_mac_label_dt)
+		ath11k_patch_mac $(macaddr_add $label_mac 3) 0
+		ath11k_remove_regdomain
+		ath11k_set_macflag
+		;;
 	esac
 	;;
 "ath11k/QCN9074/hw1.0/cal-pci-0000:01:00.0.bin")
@@ -155,6 +163,13 @@ case "$FIRMWARE" in
 		ath11k_remove_regdomain
 		ath11k_set_macflag
 		;;
+	zyxel,wax640s-6e)
+		caldata_extract "0:art" 0x4c000 0x20000
+		label_mac=$(get_mac_label_dt)
+		ath11k_patch_mac $(macaddr_add $label_mac 4) 0
+		ath11k_remove_regdomain
+		ath11k_set_macflag
+		;;
 	esac
 	;;
 *)
diff --git a/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/ieee80211/05-wifi-migrate b/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/ieee80211/05-wifi-migrate
index d3460db582..71471a21ae 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/ieee80211/05-wifi-migrate
+++ b/target/linux/qualcommax/ipq50xx/base-files/etc/hotplug.d/ieee80211/05-wifi-migrate
@@ -60,6 +60,9 @@ linksys,mx5500|\
 linksys,spnmx56)
 	migrate_radio 'soc@0/a0000000.pcie/pci0001:00/0001:00:00.0/0001:01:00.0' 'soc@0/a0000000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
 	;;
+zyxel,wax640s-6e)
+	migrate_radio 'platform/soc@0/b00a040.wifi' 'platform/soc@0/b00b040.wifi'
+	;;
 esac
 
 $WIRELESS_CHANGED && uci commit wireless
diff --git a/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh b/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
index 9df8cf4424..90c82d3983 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
+++ b/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
@@ -230,7 +230,8 @@ platform_do_upgrade() {
 		CI_DATA_UBIPART="rootfs"
 		nand_do_upgrade "$1"
 		;;
-	zyxel,nwa220ax-6e)
+	zyxel,nwa220ax-6e|\
+	zyxel,wax640s-6e)
 		# Zyxel U-Boot always passes ubi.mtd=rootfs, so OpenWrt
 		# can only run from image0. The zyxel-bootconfig preinit
 		# hook keeps image0 selected in 0:bootconfig{,1}.
