 .../boot/dts/qcom/ipq5018-wax640s-6e.dts      | 141 ++++++++++++++++++
 target/linux/qualcommax/image/ipq50xx.mk      |  22 +++
 .../ipq50xx/base-files/etc/board.d/01_leds    |   3 +-
 .../ipq50xx/base-files/etc/board.d/02_network |   3 +-
 .../etc/hotplug.d/firmware/11-ath11k-caldata  |  17 ++-
 .../etc/hotplug.d/ieee80211/05-wifi-migrate   |   3 +
 .../base-files/lib/upgrade/platform.sh        |   3 +-
 8 files changed, 190 insertions(+), 5 deletions(-)
