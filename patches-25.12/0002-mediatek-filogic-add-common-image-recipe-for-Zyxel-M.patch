From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Chiou <chiouss@gmail.com>
Date: Sun, 1 Nov 2026 14:02:01 +0800
Subject: [PATCH] mediatek: filogic: add common image recipe for Zyxel MT7981B
 devices

Move the NWA50AX Pro image settings into Device/zyxel_filogic_common,
so other Zyxel MT7981B access points with the same flash layout and
factory image format can reuse them.

Replace Build/zyxel-nwa-fit-filogic, which had the model IDs of the
factory image's "compat-models" list hardcoded, with the common
zyxel-fit-factory-img recipe, added with the NWA50AX Pro model IDs
through Device/zyxel-fit-factory-img. The NWA50AX Pro factory image is
unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Mark Chiou <chiouss@gmail.com>
---
 target/linux/mediatek/image/filogic.mk | 24 ++++++++++--------------
 1 file changed, 10 insertions(+), 14 deletions(-)

diff --git a/target/linux/mediatek/image/filogic.mk b/target/linux/mediatek/image/filogic.mk
index 1696036692..4493a6886e 100644
--- a/target/linux/mediatek/image/filogic.mk
+++ b/target/linux/mediatek/image/filogic.mk
@@ -117,13 +117,6 @@ define Build/mstc-header
   mv $@.new $@
 endef
 
-define Build/zyxel-nwa-fit-filogic
-	$(TOPDIR)/scripts/mkits-zyxel-fit-filogic.sh \
-		$@.its $@ "80 e1 81 e1 ff ff ff ff ff ff"
-	PATH=$(LINUX_DIR)/scripts/dtc:$(PATH) mkimage -f $@.its $@.new
-	@mv $@.new $@
-endef
-
 define Build/cetron-header
 	$(eval magic=$(word 1,$(1)))
 	$(eval model=$(word 2,$(1)))
@@ -3863,12 +3856,8 @@ define Device/zyxel_ex5700-telenor
 endef
 TARGET_DEVICES += zyxel_ex5700-telenor
 
-define Device/zyxel_nwa50ax-pro
+define Device/zyxel_filogic_common
   DEVICE_VENDOR := Zyxel
-  DEVICE_MODEL := NWA50AX Pro
-  DEVICE_ALT0_VENDOR := Zyxel
-  DEVICE_ALT0_MODEL := NWA90AX Pro
-  DEVICE_DTS := mt7981b-zyxel-nwa50ax-pro
   DEVICE_DTS_DIR := ../dts
   DEVICE_PACKAGES := kmod-mt7915e kmod-mt7981-firmware mt7981-wo-firmware zyxel-bootconfig
   DEVICE_DTS_LOADADDR := 0x44000000
@@ -3877,10 +3866,17 @@ define Device/zyxel_nwa50ax-pro
   PAGESIZE := 2048
   IMAGE_SIZE := 51200k
   KERNEL_IN_UBI := 1
-  IMAGES += factory.bin
-  IMAGE/factory.bin := append-ubi | check-size $$$$(IMAGE_SIZE) | zyxel-nwa-fit-filogic
   IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
 endef
+
+define Device/zyxel_nwa50ax-pro
+  $(call Device/zyxel_filogic_common)
+  DEVICE_MODEL := NWA50AX Pro
+  DEVICE_ALT0_VENDOR := Zyxel
+  DEVICE_ALT0_MODEL := NWA90AX Pro
+  DEVICE_DTS := mt7981b-zyxel-nwa50ax-pro
+  $(call Device/zyxel-fit-factory-img,80 e1,81 e1)
+endef
 TARGET_DEVICES += zyxel_nwa50ax-pro
 
 define Device/zyxel_wx5600-t0-ubootmod
